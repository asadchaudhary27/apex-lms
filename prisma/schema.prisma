generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

// role stored as String in DB for SQLite compatibility

// ─────────────────────────────────────────────────────────────
// BRANCH / CAMPUS
// ─────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  currency  String   @default("PKR")
  timezone  String   @default("Asia/Karachi")
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  departments   Department[]
  academicYears AcademicYear[]
  invoices      Invoice[]
  attendances   Attendance[]
  announcements Announcement[]
  feeCategories FeeCategory[]
}

// ─────────────────────────────────────────────────────────────
// USER & AUTHENTICATION
// Roles: HEAD_ADMIN | ADMIN | HOD | TEACHER | STUDENT | PARENT
// ─────────────────────────────────────────────────────────────

model User {
  id          String  @id @default(cuid())
  branchId    String?
  name        String?
  email       String  @unique
  password    String
  role        String  @default("STUDENT")
  permissions String? // JSON array of permission tokens
  avatarUrl   String?

  // Extended profile
  phone       String?
  cnic        String?
  address     String?
  dateOfBirth DateTime?
  gender      String? // MALE | FEMALE | OTHER
  bloodGroup  String?
  religion    String?
  nationality String?

  // Guardian / Parent
  guardianName     String?
  guardianPhone    String?
  guardianCnic     String?
  guardianRelation String?

  // Residential
  permanentAddress String?
  presentAddress   String?
  city             String?
  district         String?
  hostelResident   Boolean @default(false)

  // Professional / Academic
  designation    String?
  bio            String?
  education      String?
  emergencyName  String?
  emergencyPhone String?
  rollNumber     String?
  baseSalary     Float   @default(0)
  hourlyRate     Float   @default(0) // For part-time / overtime
  overtimeHours  Float   @default(0) // Unprocessed overtime balance
  employmentType String? // TEACHING_STAFF | NON_TEACHING_STAFF

  // Preferences
  themePreference String @default("midnight")

  joinedAt  DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete

  branch Branch? @relation(fields: [branchId], references: [id])

  // HR
  leaveRequests LeaveRequest[]
  attendances   Attendance[]

  // Academic — teacher
  classTeachers     ClassTeacher[]
  timetableSlots    Timetable[]
  examinations      Exam[]         @relation("ExamCreator")
  gradedResults     TestResult[]   @relation("GradedBy")
  behaviorLogsGiven BehaviorLog[]  @relation("TeacherLogs")
  hodDepartments    Department[]   @relation("HOD")

  // Academic — student
  sectionEnrollments SectionEnrollment[]
  testResults        TestResult[]        @relation("StudentResults")
  behaviorLogs       BehaviorLog[]       @relation("StudentLogs")
  gradebooks         Gradebook[]

  // Finance
  invoices         Invoice[]
  payments         Payment[]
  concessions      Concession[]
  feeVouchers      FeeVoucher[]
  enrollments      Enrollment[]
  recordedPayments Payment[]            @relation("PaymentRecorder")
  subjectRates     TeacherSubjectRate[]
  employeePayrolls EmployeePayroll[]
  billingPlans     BillingPlan[]

  // Parent
  parentLinks  ParentStudent[] @relation("ParentUser")
  studentLinks ParentStudent[] @relation("StudentUser")

  // Auth & System
  notifications    Notification[]
  deletionRequests DeletionRequest[] @relation("RequestedBy")
  auditTickets     AuditTicket[]     @relation("AuditRequestedBy")
  approvedAudits   AuditTicket[]     @relation("AuditApprovedBy")
  announcements    Announcement[]
  progress         Progress[]
}

// ─────────────────────────────────────────────────────────────
// PARENT ↔ STUDENT LINK
// ─────────────────────────────────────────────────────────────

model ParentStudent {
  id           String @id @default(cuid())
  parentId     String
  studentId    String
  relationship String @default("GUARDIAN") // FATHER | MOTHER | GUARDIAN

  parent  User @relation("ParentUser", fields: [parentId], references: [id])
  student User @relation("StudentUser", fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

// ─────────────────────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  branchId  String
  name      String // e.g. "2024-2025"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  branch    Branch     @relation(fields: [branchId], references: [id])
  semesters Semester[]
  classes   Class[]
}

model Semester {
  id             String   @id @default(cuid())
  academicYearId String
  name           String // e.g. "Fall 2024", "Term 1"
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  gradebooks   Gradebook[]
}

model Department {
  id       String  @id @default(cuid())
  branchId String
  name     String // e.g. "Science", "Arts", "Commerce"
  hodId    String?

  branch  Branch   @relation(fields: [branchId], references: [id])
  hod     User?    @relation("HOD", fields: [hodId], references: [id])
  classes Class[]
  courses Course[]
}

model Class {
  id             String   @id @default(cuid())
  branchId       String
  academicYearId String
  departmentId   String?
  name           String // e.g. "Grade 9", "Class 11"
  createdAt      DateTime @default(now())

  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  sections      Section[]
  feeStructures FeeStructure[]
}

model Section {
  id        String   @id @default(cuid())
  classId   String
  name      String // e.g. "A", "B", "Science", "Blue"
  capacity  Int      @default(40)
  createdAt DateTime @default(now())

  class         Class               @relation(fields: [classId], references: [id])
  classTeachers ClassTeacher[]
  timetable     Timetable[]
  enrollments   SectionEnrollment[]
  exams         Exam[]
  announcements Announcement[]
  Attendance    Attendance[]
}

model ClassTeacher {
  id             String   @id @default(cuid())
  sectionId      String
  teacherId      String
  courseId       String
  isClassTeacher Boolean  @default(false) // homeroom teacher
  createdAt      DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id])
  teacher User    @relation(fields: [teacherId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@unique([sectionId, teacherId, courseId])
}

model SectionEnrollment {
  id        String    @id @default(cuid())
  studentId String
  sectionId String
  rollNo    String?
  status    String    @default("ACTIVE") // ACTIVE | COMPLETED | DROPPED | TRANSFERRED
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  student User    @relation(fields: [studentId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  @@unique([studentId, sectionId])
}

// ─────────────────────────────────────────────────────────────
// COURSES / SUBJECTS
// ─────────────────────────────────────────────────────────────

model Course {
  id           String   @id @default(cuid())
  departmentId String?
  name         String
  code         String?
  description  String?
  creditHours  Int      @default(3)
  totalMarks   Float    @default(100)
  createdAt    DateTime @default(now())

  department    Department?          @relation(fields: [departmentId], references: [id])
  classTeachers ClassTeacher[]
  timetables    Timetable[]
  exams         Exam[]
  testResults   TestResult[]
  modules       Module[]
  Attendance    Attendance[]
  subjectRates  TeacherSubjectRate[]
}

// ─────────────────────────────────────────────────────────────
// TIMETABLE & DATE SHEET
// ─────────────────────────────────────────────────────────────

model Timetable {
  id         String   @id @default(cuid())
  sectionId  String
  courseId   String
  teacherId  String
  dayOfWeek  Int // 1=Mon...7=Sun
  startTime  String // "08:00"
  endTime    String // "08:45"
  roomNumber String?
  createdAt  DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])
  teacher User    @relation(fields: [teacherId], references: [id])
}

model DateSheet {
  id           String   @id @default(cuid())
  sectionId    String
  examId       String
  scheduledAt  DateTime
  venue        String?
  instructions String?
  createdAt    DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// EXAMINATIONS & GRADING
// ─────────────────────────────────────────────────────────────

model Exam {
  id           String   @id @default(cuid())
  sectionId    String?
  courseId     String
  createdById  String
  title        String
  type         String   @default("TEST") // TEST | MID_TERM | FINAL | ASSIGNMENT | QUIZ
  totalMarks   Float
  passingMarks Float    @default(33)
  date         DateTime
  venue        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  section     Section?     @relation(fields: [sectionId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  createdBy   User         @relation("ExamCreator", fields: [createdById], references: [id])
  testResults TestResult[]
  dateSheets  DateSheet[]
}

model TestResult {
  id            String   @id @default(cuid())
  studentId     String
  examId        String
  courseId      String
  marksObtained Float
  percentage    Float?
  grade         String? // A+, A, B+, B, C, D, F
  remarks       String?
  gradedById    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student  User   @relation("StudentResults", fields: [studentId], references: [id])
  exam     Exam   @relation(fields: [examId], references: [id])
  course   Course @relation(fields: [courseId], references: [id])
  gradedBy User?  @relation("GradedBy", fields: [gradedById], references: [id])

  @@unique([studentId, examId])
}

model Gradebook {
  id         String   @id @default(cuid())
  studentId  String
  semesterId String
  gpa        Float?
  percentage Float?
  rank       Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student  User     @relation(fields: [studentId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])

  @@unique([studentId, semesterId])
}

model BehaviorLog {
  id          String   @id @default(cuid())
  studentId   String
  teacherId   String
  type        String // PRAISE | WARNING | INCIDENT | NOTE
  description String
  date        DateTime @default(now())

  student User @relation("StudentLogs", fields: [studentId], references: [id])
  teacher User @relation("TeacherLogs", fields: [teacherId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// FINANCIAL ENGINE
// ─────────────────────────────────────────────────────────────

model FeeCategory {
  id          String   @id @default(cuid())
  branchId    String?
  name        String // TUITION | ADMISSION | LAB | TRANSPORT | EXAM | LIBRARY | SPORTS
  description String?
  isRecurring Boolean  @default(true)
  frequency   String   @default("MONTHLY") // MONTHLY | TERM | ANNUAL | ONE_TIME
  createdAt   DateTime @default(now())

  branch           Branch?           @relation(fields: [branchId], references: [id])
  feeStructures    FeeStructure[]
  voucherLineItems VoucherLineItem[]
  lateFeeRules     LateFeeRule[]
}

model FeeStructure {
  id            String   @id @default(cuid())
  classId       String
  feeCategoryId String
  amount        Float
  createdAt     DateTime @default(now())

  class       Class       @relation(fields: [classId], references: [id])
  feeCategory FeeCategory @relation(fields: [feeCategoryId], references: [id])

  @@unique([classId, feeCategoryId])
}

model BillingPlan {
  id          String   @id @default(cuid())
  studentId   String
  type        String   @default("MONTHLY_INSTALLMENT") // LUMP_SUM | MONTHLY_INSTALLMENT | QUARTERLY
  description String?
  discountPct Float    @default(0) // e.g., 5% discount for lump sum
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id])

  @@unique([studentId])
}

model FeeVoucher {
  id             String    @id @default(cuid())
  studentId      String
  semesterId     String?
  challanId      String    @unique // Unique alphanumeric ID for bank scanning
  issueDate      DateTime  @default(now())
  dueDate        DateTime
  validityDate   DateTime? // extended deadline if applicable
  totalAmount    Float
  arrears        Float     @default(0) // Unpaid amounts carried over
  discountAmount Float     @default(0)
  penaltyAmount  Float     @default(0)
  netAmount      Float // totalAmount + arrears - discountAmount + penaltyAmount
  status         String    @default("UNPAID") // PAID | UNPAID | PARTIAL | OVERDUE
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  student  User              @relation(fields: [studentId], references: [id])
  items    VoucherLineItem[]
  payments Payment[]

  // legacy compatibility
  userId  String?
  Invoice Invoice[]
}

model VoucherLineItem {
  id            String  @id @default(cuid())
  feeVoucherId  String
  feeCategoryId String
  description   String?
  amount        Float

  feeVoucher  FeeVoucher  @relation(fields: [feeVoucherId], references: [id])
  feeCategory FeeCategory @relation(fields: [feeCategoryId], references: [id])
}

model InstitutionalExpense {
  id           String   @id @default(cuid())
  amount       Float
  category     String // UTILITIES | MAINTENANCE | EVENTS | MISC
  description  String
  date         DateTime @default(now())
  recordedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // For simplicity, not strongly linking to a specific User yet, but we could
}

model Payment {
  id           String   @id @default(cuid())
  feeVoucherId String?
  invoiceId    String?
  studentId    String?
  amount       Float
  method       String   @default("CASH") // CASH | BANK | JAZZCASH | NAYAPAY | EASYPAISA | MEEZAN | TRANSFER
  reference    String? // bank transaction ref / slip number
  receiptNo    String?
  notes        String?
  recordedById String?
  paidAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  feeVoucher FeeVoucher? @relation(fields: [feeVoucherId], references: [id])
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id])
  student    User?       @relation(fields: [studentId], references: [id])
  recordedBy User?       @relation("PaymentRecorder", fields: [recordedById], references: [id])
}

model Concession {
  id        String    @id @default(cuid())
  studentId String
  type      String // PERCENTAGE | FLAT
  value     Float // 10 = 10% discount OR Rs.500 flat
  reason    String // SCHOLARSHIP | SIBLING | MERIT | NEED_BASED | STAFF_CHILD
  validFrom DateTime  @default(now())
  validTo   DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  student User @relation(fields: [studentId], references: [id])
}

model LateFeeRule {
  id            String   @id @default(cuid())
  feeCategoryId String?
  graceDays     Int      @default(7)
  penaltyType   String // FLAT | PERCENTAGE
  penaltyValue  Float // Rs 50 or 5%
  maxPenalty    Float? // cap
  createdAt     DateTime @default(now())

  feeCategory FeeCategory? @relation(fields: [feeCategoryId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// LEGACY INVOICE (keep existing finance flow working)
// ─────────────────────────────────────────────────────────────

model Invoice {
  id           String    @id @default(cuid())
  branchId     String
  userId       String
  feeVoucherId String?
  amount       Float
  type         String // FEE | PAYROLL
  status       String    @default("PENDING") // PENDING | PAID | CANCELLED
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch     Branch      @relation(fields: [branchId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  feeVoucher FeeVoucher? @relation(fields: [feeVoucherId], references: [id])
  payments   Payment[]
}

// ─────────────────────────────────────────────────────────────
// TEACHER PAYROLL & COMPENSATION
// ─────────────────────────────────────────────────────────────

model TeacherSubjectRate {
  id        String   @id @default(cuid())
  teacherId String
  courseId  String
  amount    Float
  type      String   @default("MONTHLY") // HOURLY | MONTHLY | PER_STUDENT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher User   @relation(fields: [teacherId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([teacherId, courseId])
}

model EmployeePayroll {
  id                String    @id @default(cuid())
  employeeId        String
  month             Int
  year              Int
  baseSalary        Float
  hourlyRate        Float     @default(0) // If applicable
  overtimeHours     Float     @default(0)
  subjectAllowances Float     @default(0)
  deductions        Float
  netAmount         Float
  status            String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | DISBURSED
  notes             String?
  approvedById      String?
  disbursedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee User          @relation(fields: [employeeId], references: [id])
  items    PayrollItem[]

  @@unique([employeeId, month, year])
}

model PayrollItem {
  id                String   @id @default(cuid())
  employeePayrollId String
  type              String // ALLOWANCE | DEDUCTION | BONUS
  amount            Float
  description       String
  createdAt         DateTime @default(now())

  employeePayroll EmployeePayroll @relation(fields: [employeePayrollId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// DELETION APPROVAL WORKFLOW
// ─────────────────────────────────────────────────────────────

model DeletionRequest {
  id             String    @id @default(cuid())
  requestedById  String
  targetModel    String // "User" | "FeeInvoice" | "TestResult" | "Exam"
  targetId       String
  targetLabel    String // human-readable e.g. "Student: Ahmed Khan (ID: clx...)"
  targetSnapshot String? // JSON snapshot of the record before deletion
  reason         String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXECUTED
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  requestedBy User @relation("RequestedBy", fields: [requestedById], references: [id])
}

// ─────────────────────────────────────────────────────────────
// COMMUNICATION & NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  branchId  String?
  sectionId String?
  authorId  String
  title     String
  body      String
  audience  String   @default("ALL") // ALL | TEACHERS | STUDENTS | PARENTS | HOD | CLASS
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch        Branch?        @relation(fields: [branchId], references: [id])
  section       Section?       @relation(fields: [sectionId], references: [id])
  author        User           @relation(fields: [authorId], references: [id])
  notifications Notification[]
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  announcementId String?
  title          String
  message        String
  type           String   @default("GENERAL") // GENERAL | FEE_DUE | FEE_OVERDUE | GRADE | ATTENDANCE | APPROVAL
  read           Boolean  @default(false)
  metadata       String? // JSON for extra data
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  announcement Announcement? @relation(fields: [announcementId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// LEGACY MODELS (keep existing functionality)
// ─────────────────────────────────────────────────────────────

model Batch {
  id           String    @id @default(cuid())
  courseId     String?
  instructorId String?
  name         String
  capacity     Int       @default(30)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollments Enrollment[]
}

model Enrollment {
  id        String    @id @default(cuid())
  userId    String
  batchId   String
  status    String    @default("ACTIVE")
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  batch Batch @relation(fields: [batchId], references: [id])
}

model Attendance {
  id        String   @id @default(cuid())
  branchId  String
  userId    String
  courseId  String?
  sectionId String?
  type      String // STUDENT | EMPLOYEE
  date      DateTime
  status    String // PRESENT | ABSENT | LATE | LEAVE | AUTHORIZED_LEAVE
  createdAt DateTime @default(now())

  branch  Branch   @relation(fields: [branchId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  course  Course?  @relation(fields: [courseId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])

  @@unique([userId, courseId, sectionId, date])
}

model LeaveRequest {
  id            String   @id @default(cuid())
  userId        String
  type          String   @default("CASUAL") // CASUAL | SICK | DUTY | MATERNITY
  startDate     DateTime
  endDate       DateTime
  reason        String?
  attachmentUrl String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AuditTicket {
  id             String    @id @default(cuid())
  actionType     String // DELETE | MODIFY
  entityType     String // STUDENT | GRADE | ATTENDANCE
  entityId       String
  originalData   String? // JSON
  proposedData   String? // JSON
  requestedById  String
  reason         String?
  status         String    @default("PENDING_HEAD_ADMIN_APPROVAL")
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  requestedBy User  @relation("AuditRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User? @relation("AuditApprovedBy", fields: [approvedById], references: [id])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id])
  lessons Lesson[]
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  content   String?
  videoUrl  String?
  type      String   @default("VIDEO") // VIDEO | TEXT | QUIZ
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module    Module     @relation(fields: [moduleId], references: [id])
  progress  Progress[]
  questions Question[]
}

model Question {
  id        String   @id @default(cuid())
  lessonId  String
  text      String
  options   String
  answer    String
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  score     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}
